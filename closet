<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#f5ede0" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="DRIP ARCHIVE" />
  <title>DRIP ARCHIVE</title>
  <link rel="manifest" href="manifest.json" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Raleway:wght@300;400;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --sand: #f5ede0;
      --bleach: #faf6ef;
      --coral: #e8806a;
      --ocean: #4a8fa8;
      --kelp: #6b8f5e;
      --foam: #dce8e8;
      --dusk: #c4a882;
      --bark: #5c3d2e;
      --ink: #1a1a1a;
      --fade: #9a8776;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Raleway', sans-serif;
      background: var(--sand);
      color: var(--ink);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 1000;
      opacity: 0.4;
    }

    /* HEADER */
    header {
      background: var(--bark);
      color: var(--sand);
      padding: 14px 20px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 3px solid var(--coral);
    }

    .logo {
      font-family: 'Bebas Neue', cursive;
      font-size: 28px;
      letter-spacing: 4px;
      color: var(--sand);
      line-height: 1;
    }

    .logo span {
      color: var(--coral);
    }

    .header-sub {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      color: var(--dusk);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: 2px;
    }

    /* NAV */
    nav {
      display: flex;
      background: var(--bleach);
      border-bottom: 2px solid var(--dusk);
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar { display: none; }

    nav button {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      background: none;
      border: none;
      padding: 14px 20px;
      cursor: pointer;
      color: var(--fade);
      white-space: nowrap;
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
      flex-shrink: 0;
    }

    nav button.active {
      color: var(--bark);
      border-bottom-color: var(--coral);
      font-weight: 700;
    }

    nav button:hover:not(.active) {
      color: var(--bark);
    }

    /* PAGES */
    .page { display: none; padding: 20px; animation: fadeIn 0.3s ease; }
    .page.active { display: block; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* SECTION TITLES */
    .section-title {
      font-family: 'Bebas Neue', cursive;
      font-size: 36px;
      letter-spacing: 3px;
      color: var(--bark);
      line-height: 1;
      margin-bottom: 4px;
    }

    .section-sub {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: var(--fade);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    /* UPLOAD ZONE */
    .upload-zone {
      border: 2px dashed var(--dusk);
      border-radius: 4px;
      padding: 40px 20px;
      text-align: center;
      background: var(--bleach);
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 24px;
      position: relative;
    }

    .upload-zone:hover, .upload-zone.dragover {
      border-color: var(--coral);
      background: #fef9f4;
    }

    .upload-zone input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    .upload-icon {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .upload-zone h3 {
      font-family: 'Bebas Neue', cursive;
      font-size: 22px;
      letter-spacing: 2px;
      color: var(--bark);
      margin-bottom: 6px;
    }

    .upload-zone p {
      font-size: 12px;
      color: var(--fade);
      font-family: 'Space Mono', monospace;
    }

    /* CATEGORY LABEL PROMPT */
    .category-prompt {
      display: none;
      background: var(--bleach);
      border: 2px solid var(--coral);
      border-radius: 4px;
      padding: 20px;
      margin-bottom: 24px;
    }

    .category-prompt.visible { display: block; }

    .category-prompt h4 {
      font-family: 'Bebas Neue', cursive;
      font-size: 20px;
      letter-spacing: 2px;
      margin-bottom: 4px;
      color: var(--bark);
    }

    .category-prompt p {
      font-size: 11px;
      color: var(--fade);
      font-family: 'Space Mono', monospace;
      margin-bottom: 14px;
    }

    .pending-preview {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 4px;
      margin-bottom: 14px;
      border: 2px solid var(--dusk);
    }

    .cat-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .cat-btn {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
      background: var(--sand);
      border: 1.5px solid var(--dusk);
      border-radius: 2px;
      padding: 8px 4px;
      cursor: pointer;
      color: var(--bark);
      transition: all 0.15s;
    }

    .cat-btn:hover, .cat-btn.selected {
      background: var(--coral);
      border-color: var(--coral);
      color: white;
    }

    .confirm-btn {
      margin-top: 12px;
      width: 100%;
      font-family: 'Bebas Neue', cursive;
      font-size: 18px;
      letter-spacing: 3px;
      background: var(--bark);
      color: var(--sand);
      border: none;
      padding: 12px;
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .confirm-btn:hover { background: var(--coral); }
    .confirm-btn:disabled { background: var(--fade); cursor: default; }

    /* CLOSET GRID */
    .filter-bar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .filter-chip {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      background: var(--bleach);
      border: 1.5px solid var(--dusk);
      border-radius: 20px;
      padding: 5px 12px;
      cursor: pointer;
      color: var(--fade);
      transition: all 0.15s;
    }

    .filter-chip.active {
      background: var(--ocean);
      border-color: var(--ocean);
      color: white;
    }

    .closet-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .closet-item {
      position: relative;
      aspect-ratio: 3/4;
      border-radius: 4px;
      overflow: hidden;
      background: var(--bleach);
      border: 1.5px solid var(--dusk);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .closet-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(92,61,46,0.15);
    }

    .closet-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .item-label {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(26,26,26,0.7));
      padding: 16px 6px 6px;
      font-family: 'Space Mono', monospace;
      font-size: 8px;
      color: white;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .item-delete {
      position: absolute;
      top: 5px;
      right: 5px;
      background: rgba(232,128,106,0.9);
      border: none;
      border-radius: 50%;
      width: 22px;
      height: 22px;
      font-size: 12px;
      cursor: pointer;
      color: white;
      display: none;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    .closet-item:hover .item-delete { display: flex; }

    .empty-closet {
      grid-column: 1/-1;
      text-align: center;
      padding: 60px 20px;
      color: var(--fade);
    }

    .empty-closet .big-emoji { font-size: 48px; margin-bottom: 12px; }
    .empty-closet p {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: 1px;
    }

    /* OUTFITS PAGE */
    .outfit-controls {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .vibe-btn {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      border: 1.5px solid var(--dusk);
      background: var(--bleach);
      border-radius: 2px;
      padding: 8px 14px;
      cursor: pointer;
      color: var(--fade);
      transition: all 0.15s;
      flex: 1;
      min-width: 80px;
    }

    .vibe-btn.active {
      background: var(--kelp);
      border-color: var(--kelp);
      color: white;
    }

    .generate-btn {
      width: 100%;
      font-family: 'Bebas Neue', cursive;
      font-size: 22px;
      letter-spacing: 4px;
      background: var(--coral);
      color: white;
      border: none;
      padding: 16px;
      border-radius: 2px;
      cursor: pointer;
      margin-bottom: 24px;
      transition: all 0.2s;
      position: relative;
      overflow: hidden;
    }

    .generate-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.15) 50%, transparent 60%);
      transform: translateX(-100%);
      transition: transform 0.4s;
    }

    .generate-btn:hover::after { transform: translateX(100%); }
    .generate-btn:hover { background: #d46a54; }
    .generate-btn:disabled { background: var(--dusk); cursor: default; }

    .outfit-card {
      background: var(--bleach);
      border: 1.5px solid var(--dusk);
      border-radius: 4px;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .outfit-header {
      background: var(--bark);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .outfit-name {
      font-family: 'Bebas Neue', cursive;
      font-size: 18px;
      letter-spacing: 2px;
      color: var(--sand);
    }

    .outfit-vibe-tag {
      font-family: 'Space Mono', monospace;
      font-size: 8px;
      letter-spacing: 1px;
      color: var(--coral);
      text-transform: uppercase;
    }

    .outfit-items {
      display: flex;
      gap: 8px;
      padding: 12px;
      overflow-x: auto;
    }

    .outfit-piece {
      flex-shrink: 0;
      width: 90px;
      text-align: center;
    }

    .outfit-piece img {
      width: 90px;
      height: 110px;
      object-fit: cover;
      border-radius: 3px;
      border: 1.5px solid var(--dusk);
    }

    .outfit-piece-label {
      font-family: 'Space Mono', monospace;
      font-size: 7px;
      color: var(--fade);
      margin-top: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .outfit-tip {
      padding: 10px 14px 14px;
      font-size: 12px;
      color: var(--bark);
      line-height: 1.6;
      border-top: 1px solid var(--dusk);
      font-style: italic;
    }

    .outfit-tip strong {
      font-style: normal;
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--coral);
      display: block;
      margin-bottom: 4px;
    }

    .no-outfit-msg {
      text-align: center;
      padding: 40px 20px;
      color: var(--fade);
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      line-height: 1.8;
    }

    /* LOADING SPINNER */
    .loading-wrap {
      text-align: center;
      padding: 40px;
    }

    .wave-loader {
      display: flex;
      justify-content: center;
      gap: 5px;
      margin-bottom: 16px;
    }

    .wave-loader span {
      width: 6px;
      height: 6px;
      background: var(--ocean);
      border-radius: 50%;
      animation: wave 1s infinite ease-in-out;
    }

    .wave-loader span:nth-child(2) { animation-delay: 0.15s; background: var(--coral); }
    .wave-loader span:nth-child(3) { animation-delay: 0.3s; background: var(--kelp); }
    .wave-loader span:nth-child(4) { animation-delay: 0.45s; background: var(--coral); }
    .wave-loader span:nth-child(5) { animation-delay: 0.6s; background: var(--ocean); }

    @keyframes wave {
      0%, 80%, 100% { transform: scale(1); opacity: 0.5; }
      40% { transform: scale(1.5); opacity: 1; }
    }

    .loading-text {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--fade);
    }

    /* STATS PAGE */
    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: var(--bleach);
      border: 1.5px solid var(--dusk);
      border-radius: 4px;
      padding: 16px;
      text-align: center;
    }

    .stat-num {
      font-family: 'Bebas Neue', cursive;
      font-size: 42px;
      color: var(--coral);
      line-height: 1;
    }

    .stat-label {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--fade);
      margin-top: 4px;
    }

    .cat-breakdown {
      background: var(--bleach);
      border: 1.5px solid var(--dusk);
      border-radius: 4px;
      padding: 16px;
    }

    .cat-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .cat-name {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--bark);
      width: 80px;
      flex-shrink: 0;
    }

    .cat-bar-wrap {
      flex: 1;
      height: 8px;
      background: var(--sand);
      border-radius: 4px;
      overflow: hidden;
    }

    .cat-bar {
      height: 100%;
      border-radius: 4px;
      background: var(--ocean);
      transition: width 0.8s ease;
    }

    .cat-count {
      font-family: 'Bebas Neue', cursive;
      font-size: 16px;
      color: var(--fade);
      width: 20px;
      text-align: right;
    }

    /* TOAST */
    .toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--bark);
      color: var(--sand);
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 1px;
      padding: 10px 20px;
      border-radius: 2px;
      z-index: 999;
      transition: transform 0.3s ease;
      white-space: nowrap;
      border-left: 3px solid var(--coral);
    }

    .toast.show { transform: translateX(-50%) translateY(0); }

    /* INSTALL BANNER */
    .install-banner {
      display: none;
      background: var(--ocean);
      color: white;
      padding: 12px 16px;
      align-items: center;
      gap: 10px;
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 1px;
    }

    .install-banner.visible { display: flex; }
    .install-banner-text { flex: 1; }

    .install-btn {
      background: white;
      color: var(--ocean);
      border: none;
      padding: 6px 14px;
      font-family: 'Bebas Neue', cursive;
      font-size: 14px;
      letter-spacing: 2px;
      border-radius: 2px;
      cursor: pointer;
      flex-shrink: 0;
    }

    .dismiss-install {
      background: none;
      border: none;
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      font-size: 16px;
      padding: 0 4px;
    }

    /* SCROLLBAR */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: var(--sand); }
    ::-webkit-scrollbar-thumb { background: var(--dusk); border-radius: 2px; }
  </style>

</head>
<body>

<div class="install-banner" id="installBanner">
  <div class="install-banner-text">ADD TO HOME SCREEN FOR APP EXPERIENCE</div>
  <button class="install-btn" id="installBtn">INSTALL</button>
  <button class="dismiss-install" id="dismissInstall">✕</button>
</div>

<header>
  <div>
    <div class="logo">DRIP <span>ARCHIVE</span></div>
    <div class="header-sub">Y2K · SURF · STYLE</div>
  </div>
  <div style="font-size:22px;">🤙</div>
</header>

<nav>
  <button class="active" onclick="showPage('closet', this)">CLOSET</button>
  <button onclick="showPage('outfits', this)">OUTFITS</button>
  <button onclick="showPage('stats', this)">STATS</button>
</nav>

<!-- ═══ CLOSET PAGE ═══ -->

<div class="page active" id="page-closet">
  <div class="section-title">MY CLOSET</div>
  <div class="section-sub">DROP YOUR FITS BELOW</div>

  <div class="upload-zone" id="uploadZone">
    <input type="file" id="fileInput" accept="image/*" multiple />
    <div class="upload-icon">👕</div>
    <h3>UPLOAD FITS</h3>
    <p>TAP TO BROWSE OR DRAG & DROP<br>JPG · PNG · WEBP</p>
  </div>

  <div class="category-prompt" id="categoryPrompt">
    <img src="" class="pending-preview" id="pendingPreview" alt="pending item" />
    <h4>WHAT'S THIS PIECE?</h4>
    <p>SELECT A CATEGORY TO FILE YOUR FIT</p>
    <div class="cat-grid" id="catGrid">
      <button class="cat-btn" data-cat="tops">TOPS</button>
      <button class="cat-btn" data-cat="bottoms">BOTTOMS</button>
      <button class="cat-btn" data-cat="outerwear">OUTERWEAR</button>
      <button class="cat-btn" data-cat="shoes">SHOES</button>
      <button class="cat-btn" data-cat="accessories">ACCESSORIES</button>
      <button class="cat-btn" data-cat="swimwear">SWIMWEAR</button>
      <button class="cat-btn" data-cat="dresses">DRESSES</button>
      <button class="cat-btn" data-cat="bags">BAGS</button>
      <button class="cat-btn" data-cat="other">OTHER</button>
    </div>
    <button class="confirm-btn" id="confirmCat" disabled>ARCHIVE IT →</button>
  </div>

  <div class="filter-bar" id="filterBar">
    <button class="filter-chip active" data-filter="all" onclick="filterCloset('all', this)">ALL</button>
    <button class="filter-chip" data-filter="tops" onclick="filterCloset('tops', this)">TOPS</button>
    <button class="filter-chip" data-filter="bottoms" onclick="filterCloset('bottoms', this)">BOTTOMS</button>
    <button class="filter-chip" data-filter="outerwear" onclick="filterCloset('outerwear', this)">OUTERWEAR</button>
    <button class="filter-chip" data-filter="shoes" onclick="filterCloset('shoes', this)">SHOES</button>
    <button class="filter-chip" data-filter="accessories" onclick="filterCloset('accessories', this)">ACCESSORIES</button>
    <button class="filter-chip" data-filter="swimwear" onclick="filterCloset('swimwear', this)">SWIMWEAR</button>
    <button class="filter-chip" data-filter="dresses" onclick="filterCloset('dresses', this)">DRESSES</button>
  </div>

  <div class="closet-grid" id="closetGrid">
    <div class="empty-closet">
      <div class="big-emoji">🏄</div>
      <p>YOUR CLOSET IS EMPTY<br>UPLOAD SOME FITS TO START</p>
    </div>
  </div>
</div>

<!-- ═══ OUTFITS PAGE ═══ -->

<div class="page" id="page-outfits">
  <div class="section-title">OUTFIT BUILDER</div>
  <div class="section-sub">AI-STYLED FROM YOUR CLOSET</div>

  <div class="outfit-controls">
    <button class="vibe-btn active" data-vibe="y2k" onclick="setVibe('y2k', this)">Y2K VIBES</button>
    <button class="vibe-btn" data-vibe="surf" onclick="setVibe('surf', this)">SURF CORE</button>
    <button class="vibe-btn" data-vibe="mix" onclick="setVibe('mix', this)">MIXED FIT</button>
  </div>

  <button class="generate-btn" id="generateBtn" onclick="generateOutfits()">
    ✦ GENERATE FITS ✦
  </button>

  <div id="outfitsContainer">
    <div class="no-outfit-msg">
      HIT GENERATE TO GET OUTFIT IDEAS<br>
      FROM YOUR ARCHIVED PIECES 🌊
    </div>
  </div>
</div>

<!-- ═══ STATS PAGE ═══ -->

<div class="page" id="page-stats">
  <div class="section-title">CLOSET STATS</div>
  <div class="section-sub">YOUR DRIP BREAKDOWN</div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-num" id="statTotal">0</div>
      <div class="stat-label">TOTAL PIECES</div>
    </div>
    <div class="stat-card">
      <div class="stat-num" id="statOutfits">0</div>
      <div class="stat-label">OUTFITS MADE</div>
    </div>
    <div class="stat-card">
      <div class="stat-num" id="statMostCat">—</div>
      <div class="stat-label">TOP CATEGORY</div>
    </div>
    <div class="stat-card">
      <div class="stat-num" id="statCombos">0</div>
      <div class="stat-label">POSSIBLE COMBOS</div>
    </div>
  </div>

  <div class="cat-breakdown">
    <div class="section-sub" style="margin-bottom:14px;">BY CATEGORY</div>
    <div id="catBreakdown"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ──────────────────────────────────────────
  // STATE
  // ──────────────────────────────────────────
  let closet = JSON.parse(localStorage.getItem('dripArchive') || '[]');
  let generatedOutfits = JSON.parse(localStorage.getItem('dripOutfits') || '[]');
  let pendingFiles = [];
  let pendingIndex = 0;
  let selectedCat = null;
  let currentVibe = 'y2k';
  let currentFilter = 'all';
  let outfitCount = parseInt(localStorage.getItem('dripOutfitCount') || '0');

  function save() {
    localStorage.setItem('dripArchive', JSON.stringify(closet));
    localStorage.setItem('dripOutfits', JSON.stringify(generatedOutfits));
    localStorage.setItem('dripOutfitCount', outfitCount);
  }

  // ──────────────────────────────────────────
  // NAV
  // ──────────────────────────────────────────
  function showPage(id, btn) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
    document.getElementById('page-' + id).classList.add('active');
    btn.classList.add('active');
    if (id === 'stats') updateStats();
  }

  // ──────────────────────────────────────────
  // UPLOAD & CATEGORIZE
  // ──────────────────────────────────────────
  document.getElementById('fileInput').addEventListener('change', e => {
    pendingFiles = Array.from(e.target.files);
    pendingIndex = 0;
    e.target.value = '';
    if (pendingFiles.length) showNextPending();
  });

  const uploadZone = document.getElementById('uploadZone');
  uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('dragover'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
  uploadZone.addEventListener('drop', e => {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    pendingFiles = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'));
    pendingIndex = 0;
    if (pendingFiles.length) showNextPending();
  });

  function showNextPending() {
    if (pendingIndex >= pendingFiles.length) {
      document.getElementById('categoryPrompt').classList.remove('visible');
      renderCloset();
      return;
    }
    selectedCat = null;
    document.getElementById('confirmCat').disabled = true;
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('selected'));

    const file = pendingFiles[pendingIndex];
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('pendingPreview').src = e.target.result;
    };
    reader.readAsDataURL(file);
    document.getElementById('categoryPrompt').classList.add('visible');
    document.getElementById('categoryPrompt').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedCat = btn.dataset.cat;
      document.getElementById('confirmCat').disabled = false;
    });
  });

  document.getElementById('confirmCat').addEventListener('click', () => {
    if (!selectedCat) return;
    const file = pendingFiles[pendingIndex];
    const reader = new FileReader();
    reader.onload = e => {
      closet.push({
        id: Date.now() + Math.random(),
        src: e.target.result,
        category: selectedCat,
        name: selectedCat.toUpperCase() + ' #' + (closet.filter(i => i.category === selectedCat).length + 1),
        added: new Date().toISOString()
      });
      save();
      pendingIndex++;
      showToast('PIECE ARCHIVED 🤙');
      showNextPending();
      renderCloset();
    };
    reader.readAsDataURL(file);
  });

  // ──────────────────────────────────────────
  // RENDER CLOSET
  // ──────────────────────────────────────────
  function filterCloset(filter, btn) {
    currentFilter = filter;
    document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    renderCloset();
  }

  function renderCloset() {
    const grid = document.getElementById('closetGrid');
    const items = currentFilter === 'all' ? closet : closet.filter(i => i.category === currentFilter);

    if (items.length === 0) {
      grid.innerHTML = `<div class="empty-closet"><div class="big-emoji">${currentFilter === 'all' ? '🏄' : '🔍'}</div><p>${currentFilter === 'all' ? 'YOUR CLOSET IS EMPTY<br>UPLOAD SOME FITS TO START' : 'NO ' + currentFilter.toUpperCase() + ' IN YOUR CLOSET YET'}</p></div>`;
      return;
    }

    grid.innerHTML = items.map(item => `
      <div class="closet-item" data-id="${item.id}">
        <img src="${item.src}" alt="${item.name}" loading="lazy" />
        <div class="item-label">${item.name}</div>
        <button class="item-delete" onclick="deleteItem('${item.id}')">✕</button>
      </div>
    `).join('');
  }

  function deleteItem(id) {
    closet = closet.filter(i => String(i.id) !== String(id));
    save();
    renderCloset();
    showToast('PIECE REMOVED');
  }

  // ──────────────────────────────────────────
  // OUTFIT GENERATION (Claude AI)
  // ──────────────────────────────────────────
  function setVibe(vibe, btn) {
    currentVibe = vibe;
    document.querySelectorAll('.vibe-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  async function generateOutfits() {
    if (closet.length < 2) {
      showToast('ADD AT LEAST 2 PIECES FIRST');
      return;
    }

    const btn = document.getElementById('generateBtn');
    btn.disabled = true;

    const container = document.getElementById('outfitsContainer');
    container.innerHTML = `
      <div class="loading-wrap">
        <div class="wave-loader">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="loading-text">STYLING YOUR ARCHIVE...</div>
      </div>`;

    // Build inventory summary (no images sent to API to save tokens)
    const inventory = closet.map(i => `${i.name} (${i.category})`).join(', ');

    const vibeDescriptions = {
      y2k: 'Y2K fashion: early 2000s aesthetics, low-rise, butterfly clips, baby tees, cargo pants, platform shoes, metallic accents, mini skirts, track suits, velour, bold logos, chunky sneakers, rhinestones',
      surf: 'surf core / coastal aesthetic: boardshorts, rashguards, oversized tees, bucket hats, slides, linen, washed-out colors, relaxed fits, beach-ready, vintage surf brand vibes, Hawaiian prints',
      mix: 'Y2K meets surf: blend early 2000s nostalgia with coastal beach culture — think low-rise boardshorts, baby tees, chunky sneakers, sun-bleached cargos, surf logos, relaxed silhouettes with Y2K accessories'
    };

    const prompt = `You are a fashion stylist specializing in Y2K and surfwear/coastal aesthetics. 

The user has these clothing items in their closet:
${inventory}

Create 3 outfit combinations using ONLY items from their closet above. Each outfit should match the vibe: ${vibeDescriptions[currentVibe]}.

For each outfit provide:
1. A creative outfit name (Y2K/surf inspired, all caps, 2-4 words)
2. Which specific items to combine (use the exact names listed above)
3. A short 1-2 sentence styling tip about how to wear the combo

Respond in this exact JSON format (no markdown, just raw JSON):
{
  "outfits": [
    {
      "name": "OUTFIT NAME",
      "items": ["exact item name 1", "exact item name 2", "exact item name 3"],
      "tip": "styling tip here"
    }
  ]
}

Be creative and give real fashion advice for the ${currentVibe} aesthetic. If there aren't enough items to make 3 full outfits, make as many as you can with what's available.`;

    try {
      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 1000,
          messages: [{ role: 'user', content: prompt }]
        })
      });

      const data = await response.json();
      const text = data.content.map(c => c.text || '').join('');
      const clean = text.replace(/```json|```/g, '').trim();
      const parsed = JSON.parse(clean);

      generatedOutfits = parsed.outfits || [];
      outfitCount += generatedOutfits.length;
      save();
      renderOutfits(generatedOutfits);

    } catch (err) {
      console.error(err);
      // Fallback: generate basic outfits from closet without AI
      const fallback = generateFallbackOutfits();
      generatedOutfits = fallback;
      save();
      renderOutfits(fallback);
    }

    btn.disabled = false;
  }

  function generateFallbackOutfits() {
    // Simple rule-based fallback if API fails
    const tops = closet.filter(i => i.category === 'tops');
    const bottoms = closet.filter(i => i.category === 'bottoms');
    const shoes = closet.filter(i => i.category === 'shoes');
    const outer = closet.filter(i => i.category === 'outerwear');

    const outfits = [];
    const vibeNames = {
      y2k: [['LOW RISE MOMENT', 'BUTTERFLY EFFECT', 'CYBER BABE'],['Y2K glam tip', 'early 2000s inspo', 'cyber aesthetic']],
      surf: [['BEACH SESSION', 'COASTAL DRIFT', 'SALTWATER SOUL'],['surf tip', 'coastal tip', 'beach tip']],
      mix: [['SUN & Y2K', 'WAVE RIDER FIT', 'RETRO SHORE'],['blended tip', 'mixed vibe tip', 'fusion fit tip']]
    };

    const names = vibeNames[currentVibe][0];
    const tips = [
      'Tuck in slightly for that effortless Y2K silhouette.',
      'Throw on some chunky accessories to elevate the look.',
      'Keep it loose and sun-faded for peak coastal energy.'
    ];

    if (tops.length > 0 && bottoms.length > 0) {
      const combo = [tops[0], bottoms[0]];
      if (shoes.length > 0) combo.push(shoes[0]);
      outfits.push({ name: names[0], items: combo.map(i => i.name), tip: tips[0] });
    }

    if (tops.length > 1 && bottoms.length > 0) {
      const combo = [tops[1 % tops.length], bottoms[bottoms.length > 1 ? 1 : 0]];
      if (outer.length > 0) combo.push(outer[0]);
      outfits.push({ name: names[1], items: combo.map(i => i.name), tip: tips[1] });
    }

    if (closet.length >= 2) {
      const shuffled = [...closet].sort(() => 0.5 - Math.random()).slice(0, 3);
      outfits.push({ name: names[2], items: shuffled.map(i => i.name), tip: tips[2] });
    }

    return outfits;
  }

  function renderOutfits(outfits) {
    const container = document.getElementById('outfitsContainer');

    if (!outfits || outfits.length === 0) {
      container.innerHTML = `<div class="no-outfit-msg">COULDN'T MAKE OUTFITS WITH YOUR CURRENT PIECES 🌊<br>TRY ADDING MORE VARIETY TO YOUR CLOSET</div>`;
      return;
    }

    const vibeEmoji = { y2k: '💿', surf: '🏄', mix: '🌊' };

    container.innerHTML = outfits.map((outfit, i) => {
      // Find matching closet items
      const pieces = outfit.items
        .map(name => closet.find(c => c.name.toLowerCase() === name.toLowerCase()))
        .filter(Boolean);

      const piecesHtml = pieces.length > 0
        ? pieces.map(p => `
          <div class="outfit-piece">
            <img src="${p.src}" alt="${p.name}" loading="lazy" />
            <div class="outfit-piece-label">${p.name}</div>
          </div>`).join('')
        : outfit.items.map(name => `
          <div class="outfit-piece">
            <div style="width:90px;height:110px;background:var(--sand);border-radius:3px;border:1.5px solid var(--dusk);display:flex;align-items:center;justify-content:center;font-size:24px;">👕</div>
            <div class="outfit-piece-label">${name}</div>
          </div>`).join('');

      return `
        <div class="outfit-card">
          <div class="outfit-header">
            <div class="outfit-name">${outfit.name}</div>
            <div class="outfit-vibe-tag">${vibeEmoji[currentVibe]} ${currentVibe.toUpperCase()}</div>
          </div>
          <div class="outfit-items">${piecesHtml}</div>
          <div class="outfit-tip"><strong>✦ STYLE TIP</strong>${outfit.tip}</div>
        </div>`;
    }).join('');
  }

  // ──────────────────────────────────────────
  // STATS
  // ──────────────────────────────────────────
  function updateStats() {
    document.getElementById('statTotal').textContent = closet.length;
    document.getElementById('statOutfits').textContent = outfitCount;

    const cats = {};
    closet.forEach(i => { cats[i.category] = (cats[i.category] || 0) + 1; });

    const topCat = Object.entries(cats).sort((a,b) => b[1]-a[1])[0];
    document.getElementById('statMostCat').textContent = topCat ? topCat[0].substring(0,4).toUpperCase() : '—';

    const tops = closet.filter(i => i.category === 'tops').length;
    const bottoms = closet.filter(i => i.category === 'bottoms').length;
    const shoes = closet.filter(i => i.category === 'shoes').length;
    const combos = Math.max(tops, 1) * Math.max(bottoms, 1) * Math.max(shoes || 1, 1);
    document.getElementById('statCombos').textContent = combos > 999 ? Math.floor(combos/1000)+'K+' : combos;

    const allCats = ['tops','bottoms','outerwear','shoes','accessories','swimwear','dresses','other'];
    const maxCount = Math.max(...Object.values(cats), 1);
    const barColors = ['#4a8fa8','#e8806a','#6b8f5e','#c4a882','#4a8fa8','#e8806a','#6b8f5e','#c4a882'];

    document.getElementById('catBreakdown').innerHTML = allCats
      .filter(c => cats[c])
      .map((c, i) => `
        <div class="cat-row">
          <div class="cat-name">${c}</div>
          <div class="cat-bar-wrap">
            <div class="cat-bar" style="width:${(cats[c]/maxCount)*100}%;background:${barColors[i%barColors.length]}"></div>
          </div>
          <div class="cat-count">${cats[c]}</div>
        </div>`).join('') || '<div style="color:var(--fade);font-family:Space Mono,monospace;font-size:10px;letter-spacing:1px;">NO ITEMS YET</div>';
  }

  // ──────────────────────────────────────────
  // TOAST
  // ──────────────────────────────────────────
  let toastTimer;
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
  }

  // ──────────────────────────────────────────
  // PWA INSTALL
  // ──────────────────────────────────────────
  let deferredPrompt;
  window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    deferredPrompt = e;
    document.getElementById('installBanner').classList.add('visible');
  });

  document.getElementById('installBtn').addEventListener('click', async () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
    }
    document.getElementById('installBanner').classList.remove('visible');
  });

  document.getElementById('dismissInstall').addEventListener('click', () => {
    document.getElementById('installBanner').classList.remove('visible');
  });

  // ──────────────────────────────────────────
  // SERVICE WORKER
  // ──────────────────────────────────────────
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js').catch(() => {});
  }

  // ──────────────────────────────────────────
  // INIT
  // ──────────────────────────────────────────
  renderCloset();
</script>

</body>
</html>